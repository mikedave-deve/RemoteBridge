{
  "name": "remotebridge-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"npm:server:dev\"",
    "web": "vite",
    "server": "node --env-file-if-exists=.env server/index.js",
    "server:dev": "node --watch --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js --production",
    "lint": "oxlint",
    "preview": "vite preview",
    "create-admin": "node --env-file-if-exists=.env server/create-admin.js"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@vercel/blob": "^2.8.0",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.49.0",
    "mongodb": "^6.21.0",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.2.4",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=20.12"
  }
}
