# Copy to .env and fill in. Never commit .env.

# MongoDB (Atlas: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/premierremotebridge?retryWrites=true&w=majority)
MONGODB_URI=
# Auth — JWT_SECRET signs login sessions and approval links. Use 48+ random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=7
JWT_EXPIRES_IN_DAYS_REMEMBER=30

# Server
PORT=4000
NODE_ENV=development
# The website's address (comma-separate several). Used for links and to allow cross-site API calls.
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_LOGIN_URL=http://localhost:5173/login

# Email — sent via Hostinger's HTTP Mail API (HTTPS), not SMTP. Create a token in the
# Hostinger Panel's email provisioning tab. If HOSTINGER_API_TOKEN is blank, emails are
# saved as .html files in server/outbox instead of being sent.
HOSTINGER_API_TOKEN=
HOSTINGER_MAILBOX_ADDRESS=
EMAIL_DISPLAY_NAME=PremierRemoteBridge
# Where résumés, hiring-team messages and new sign-ups for approval are emailed.
COMPANY_NOTIFY_EMAIL=

# File storage — Vercel Blob. Connect a Blob store to the project in the Vercel
# dashboard (Storage tab) and Vercel injects BLOB_READ_WRITE_TOKEN automatically.
# When it is set, uploaded résumés, tax forms, identity selfies, documents and
# receipts are stored in Blob; otherwise they are kept in MongoDB (fine for local dev).
BLOB_READ_WRITE_TOKEN=

# Website build only: set when the API is hosted on a different domain from the website.
# On Vercel the API and site share one domain, so leave this blank.
# VITE_API_URL=https://api.yourdomain.com

# On Vercel, set FRONTEND_ORIGIN to your deployed site URL, e.g.
# FRONTEND_ORIGIN=https://your-project.vercel.app
# and FRONTEND_LOGIN_URL=https://your-project.vercel.app/login
# NODE_ENV is set to "production" by Vercel automatically.
